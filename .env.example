# =========================
# 1) 模型适配器与 Agent 行为参数
# =========================
MODEL=deepseek/deepseek-flash
# 可选：覆盖 DeepSeek 独立价格卡位置；默认读取 react_agent/configuration/deepseek_pricing.yaml。
# DEEPSEEK_PRICING_PATH=./react_agent/configuration/deepseek_pricing.yaml
# 你也可以切成 openai，例如：
# MODEL=openai/gpt-4.1-mini

ENABLE_TOOLS=true
ENABLE_WEB_SEARCH=true
LANGUAGE=zh-CN
TIMEZONE=Asia/Shanghai

# Agent 工具配置由 react_agent/configuration/settings.py 与同目录 config.yaml 管理。
# Knowledge Server 的本地 RAG/建库 Runtime 由 knowledge/server/runtime.py 读取本文件中的环境变量。
MAX_SEARCH_RESULTS=10
MAX_MODEL_ROUNDS=8
MAX_TOOL_BATCHES=6
MAX_TOOL_RETRIES=2
RAG_CALL_LIMIT=3
CONSECUTIVE_FAILURE_THRESHOLD=2
MAX_TOOL_OUTPUT_CHARS=4000
# 图执行异常熔断；必须高于上述业务预算所需的最大图节点数。
RECURSION_LIMIT=50
MAX_HISTORY_TOKENS=80000
MAX_INPUT_TOKENS=96000
# 达到历史预算约 80% 时，对较早完整轮次执行一次可追溯摘要；额外模型调用计费用量。
ENABLE_HISTORY_COMPACTION=true
HISTORY_COMPACTION_MAX_OUTPUT_TOKENS=768
# 压缩被拒绝后，只有可压缩来源至少新增该 Token 数才再次调用模型。
HISTORY_COMPACTION_RETRY_NEW_TOKENS=512
CONTEXT_SAFETY_MARGIN_TOKENS=1024

# =========================
# 2) Tavily 搜索（你启用 web_search 时需要）
# =========================
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# =========================
# 3) 推理参数（你 utils.py 里读取这些）
# =========================
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
# deepseek-flash 当前窗口；切换模型时必须同步更新。
LLM_CONTEXT_WINDOW_TOKENS=1048576
LLM_TIMEOUT=60
LLM_RETRIES=2

# =========================
# 4) OpenAI / DeepSeek / 本地 OpenAI-compatible（按需填）
# =========================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_OPENAI_API_KEY=local-key

# =========================
# 5) 对话持久化（推荐 PostgreSQL；SQLite 仅作为本地备用）
# =========================
CHECKPOINT_BACKEND=postgres
CHECKPOINT_DB_PATH=./data/agent-state/agent_checkpoints.sqlite3
# 与代码使用的变量名保持一致；请替换为本机 PostgreSQL 账号、密码和数据库。
POSTGRES_DB_URL=postgresql://agent_user:agent_password@127.0.0.1:5432/finance_agent
# Docker 容器不能用 127.0.0.1 访问 Windows 上的 PostgreSQL。
POSTGRES_DOCKER_DB_URL=postgresql://agent_user:agent_password@host.docker.internal:5432/finance_agent
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
# 限制 LangGraph Checkpoint 反序列化允许的类型。
LANGGRAPH_STRICT_MSGPACK=true
# =========================
# 6) Redis 本地缓存（不存 Agent 会话，不需要 Redis Stack/RedisInsight）
# =========================
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=20
SEMANTIC_CACHE_TTL=3600
SEMANTIC_CACHE_THRESHOLD=0.95
BM25_INDEX_TTL=86400
# 使用随机长字符串；未配置时会安全地跳过 BM25 的 Redis 序列化缓存。
BM25_HMAC_SECRET=replace-with-a-random-secret

# 独立知识库服务。Agent/MCP/Windows CLI 配置 URL 后只通过 HTTP 访问，
# 不再直接打开 CHROMA_DB_PATH。请为非单机开发环境设置随机长密钥。
RAG_RUNTIME_MODE=remote
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8001
KNOWLEDGE_SERVICE_API_KEY=replace-with-a-random-secret
KNOWLEDGE_SERVICE_REQUIRE_API_KEY=true
KNOWLEDGE_SERVICE_TIMEOUT=150
KNOWLEDGE_SERVICE_INGESTION_ROOT=./FinancialResearchReportData
# 后台启动，不阻塞 liveness；readiness 会真实检查知识库。
KNOWLEDGE_SERVICE_WARMUP_ON_START=true
# 生产默认关闭；docker-compose.dev.yml 在开发环境显式开启。
KNOWLEDGE_SERVICE_EVALUATION_API_ENABLED=false
# MCP 默认只暴露查询与服务信息；管理/预热工具需显式开启。
MCP_EXPOSE_ADMIN_TOOLS=false
# MCP_ENV_FILE 需由启动环境显式传入，用于改读其他 env 文件；
# 普通安装默认读取当前工作目录的 .env。
# MCP_ENV_FILE=./config/mcp.env
# 相对路径以 MCP 运行根目录为基准；日志不可写时自动降级为 stderr。
MCP_LOG_PATH=./logs/mcp_debug.log
# Knowledge Service 默认只使用已存 Hugging Face 模型，避免预热依赖外网。
# 首次准备空模型缓存时临时改为 false，下载完成后恢复 true。
HF_HUB_OFFLINE=true
TRANSFORMERS_OFFLINE=true

# RAG 本地模型设备：auto 自动探测；cpu 强制 CPU；cuda 优先 CUDA、不可用时回退 CPU。
# Docker Compose 会显式覆盖为 cpu，本机直接运行时可按硬件调整。
RAG_DEVICE=auto
# CPU/GPU 双档参数；RAG_RERANK_CANDIDATES、
# RAG_RERANKER_CONCURRENCY、RAG_RERANKER_BATCH_SIZE 可用于临时覆盖两个档位。
RAG_CPU_RERANK_CANDIDATES=12
RAG_CUDA_RERANK_CANDIDATES=20
RAG_RERANK_TOP_N=5
RAG_CPU_RERANKER_CONCURRENCY=1
RAG_CUDA_RERANKER_CONCURRENCY=1
RAG_CPU_RERANKER_BATCH_SIZE=2
RAG_CUDA_RERANKER_BATCH_SIZE=32
# 运行数据路径；相对路径统一以 src（容器内为 /app）为基准。
DATA_DIR=./data
CHROMA_DB_PATH=./chroma_db
HASH_RECORD_PATH=./chroma_db/file_hashes.json
CHUNK_STORE_PATH=./data/knowledge/chunks.sqlite3
SQL_DB_PATH=./data_sql/financials.db
OUTPUT_DIR=./outputs
# 模型下载端点；国内镜像不稳定时保留官方地址并通过代理访问。
HF_ENDPOINT=https://huggingface.co

# =========================
# 7) Docling 离线 PDF 解析（默认关闭，避免影响现有建库）
# =========================
DOCLING_ENABLED=false
# true：Docling 失败时终止本次建库，不把低质量本地回退结果混入知识库。
# Docker 全量建库默认覆盖为 true；本机临时解析可按需保留 false。
DOCLING_STRICT_MODE=false
# auto：扫描/图像密集 PDF 使用 Docling，其余使用现有本地解析器
# local：始终使用本地解析器；docling：始终使用 Docling
DOCLING_PARSER_MODE=auto
DOCLING_BASE_URL=http://127.0.0.1:5001
DOCLING_API_KEY=
DOCLING_REQUEST_TIMEOUT=120
DOCLING_TASK_TIMEOUT=3600
DOCLING_POLL_INTERVAL=2
# 交给 Docling 的单个 PDF 子任务页数；子任务严格顺序执行以限制内存峰值。
DOCLING_MAX_PAGES_PER_TASK=3
# 每个分页子任务失败后的额外重试次数。
DOCLING_SEGMENT_RETRIES=1
DOCLING_AUTO_IMAGE_BYTES_PER_PAGE=307200
DOCLING_AUTO_MIN_TEXT_CHARS_PER_PAGE=100
DOCLING_AUTO_MIN_IMAGE_AREA_RATIO=0.15
DOCLING_AUTO_MIN_TABLE_LIKE_PAGES_RATIO=0.6
DOCLING_AUTO_MIN_MULTI_COLUMN_PAGES_RATIO=0.4
DOCLING_AUTO_SAMPLE_PAGES=5
# 超过此页数的 PDF 直接排除，不进入任一解析器
DOCLING_MAX_PDF_PAGES=200
# 本地解析质量门槛；auto 模式不达标时转交 Docling
DOCLING_LOCAL_MIN_PAGE_COVERAGE=0.65
DOCLING_LOCAL_MIN_CHARS_PER_PAGE=80
DOCLING_LOCAL_MAX_REPLACEMENT_RATIO=0.005
DOCLING_LOCAL_MIN_TRACEABLE_RATIO=0.95

# 离线建库资源边界；低内存/CPU 笔记本优先使用 1 个解析进程和较小批次。
RAG_INGESTION_WORKERS=1
RAG_INGESTION_BATCH_SIZE=1000
RAG_INGESTION_FAIL_FAST=true
